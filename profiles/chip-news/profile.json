{
  "id": "chip-news",
  "name": "Global Chips",
  "display_names": {
    "zh": "全球芯片"
  },
  "match": "match.md",
  "analysis": "analysis.md",
  "content": {
    "analysis_max_chars": 12000,
    "enrichment_max_chars": 16000,
    "sampling": "prefix"
  },
  "enrichment": {
    "prompt": "enrichment.md",
    "blocks": [
      {
        "id": "summary",
        "type": "section",
        "tools": [],
        "primary": true
      },
      {
        "id": "background",
        "type": "section",
        "tools": ["history_search", "web_search"]
      },
      {
        "id": "impact",
        "type": "section",
        "tools": ["web_search"],
        "optional": true
      },
      {
        "id": "community_discussion",
        "type": "section",
        "tools": [],
        "optional": true
      }
    ]
  }
}
